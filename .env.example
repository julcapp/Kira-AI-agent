# Change these before exposing the server to the internet
APP_API_KEY=replace-with-long-random-secret
MAX_WEBHOOK_SECRET=replace-with-long-random-webhook-secret
MAX_BOT_TOKEN=
MAX_ALLOWED_USER_IDS=
MAX_ENABLED=false
DATABASE_URL=sqlite:///./data/kiryusha.db
# Example production: postgresql+psycopg://kiryusha:password@db:5432/kiryusha
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
DEFAULT_TIMEZONE=Europe/Moscow
SCHEDULER_ENABLED=true

# TTS through an OpenAI-compatible audio/speech endpoint; only used for MAX replies.
TTS_ENABLED=false
TTS_API_KEY=
TTS_BASE_URL=https://api.openai.com/v1
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy
